# ============================================================
# SMC Sudan MOBA Community - API Environment Variables
# ============================================================

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://smc_user:smc_password@localhost:5432/smc_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Sync Engine
SYNC_CONCURRENCY=5
SYNC_BATCH_SIZE=50

# Admin
ADMIN_JWT_SECRET=change-this-to-a-secure-random-string-in-production
ADMIN_JWT_EXPIRY=24h

# MLBB API
MLBB_API_TIMEOUT=10000
MLBB_MAX_RETRIES=3

# Logging
LOG_LEVEL=debug
