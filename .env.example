# ============================================================
# SMC Sudan MOBA Community - Root Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=smc_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=smc_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── API ──────────────────────────────────────────────────────
ADMIN_JWT_SECRET=change_this_to_a_very_long_random_string_minimum_64_chars
FRONTEND_URL=http://localhost:3000
SYNC_CONCURRENCY=5

# ─── Web ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
